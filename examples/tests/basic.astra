fn square(x: int32) -> int32 {
    return x * x;
}

fn main() -> int32 {
    let a: int32 = 5;
    print(square(a));

    let xs = [10, 20, 30];
    print(xs[1]);

    if (a > 3) {
        print(100);
    } else {
        print(0);
    }

    var i: int32 = 0;
    while (i < 3) {
        print(i);
        i = i + 1;
    }

    return 0;
}
