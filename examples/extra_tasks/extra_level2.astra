module Demo;

struct Point {
    x: int32;
    y: int32;
}

fn Point.sum(self: Point, bonus: int32 = 0) -> int32 {
    return self.x + self.y + bonus;
}

fn scale(x: int32) -> int32 {
    return x * 2;
}

fn scale(x: int64) -> int64 {
    return x * (3 as int64);
}

fn mix(a: int32, b: int32 = 10, c: int32 = 100) -> int32 {
    return a + b + c;
}

fn main() -> int32 {
    let p = Point { x: 3, y: 4 };

    print(p.sum());
    print(p.sum(10));

    print(mix(1));
    print(mix(1, c = 3, b = 2));

    print(scale(5));
    print(scale(5 as int64));

    return 0;
}
